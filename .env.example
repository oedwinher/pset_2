# ==============================================================================
# CONFIGURACIÓN DE ACCESO A SNOWFLAKE Y KESTRA
# Instrucciones: Copia este archivo como '.env' en la raíz del proyecto y completa
# con tus credenciales de Snowflake. NO subas el archivo '.env' a GitHub.
#   PowerShell: Copy-Item .env.example .env
#   Bash/Linux: cp .env.example .env
# ==============================================================================

# Identificador de cuenta con formato <locator>.<region> (ej. ab12345.us-east-1)
# Corresponde al prefijo de tu URL: https://<locator>.<region>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT=xy12345.us-east-1

# Usuario con permisos de creación de objetos en Snowflake
SNOWFLAKE_USER=TU_USUARIO_SNOWFLAKE

# Contraseña de la cuenta de Snowflake
SNOWFLAKE_PASSWORD=TuPasswordSeguro123!

# Rol con privilegios administrativos o de desarrollo (ej. ACCOUNTADMIN o SYSADMIN)
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Nombre del Virtual Warehouse activo para cómputo
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Base de datos central del proyecto (Kestra y dbt crearán los esquemas aquí)
SNOWFLAKE_DATABASE=PSET2_DB

# Puerto local para la interfaz web de Kestra (http://localhost:8080)
KESTRA_PORT=8080
